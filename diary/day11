#### 3. Input Validation and Error Handling
```python
from werkzeug.exceptions import BadRequest

def validate_input(input_data):
    """Validate input data"""
    
    required_features = [
        'Study Hours per Day',
        'Sleep Hours per Night',
        'Attendance Percentage',
        'Screen Time Hours',
        'Previous Exam Scores',
        'Study Consistency Score',
        'Extracurricular Activities',
        'Class Participation'
    ]
    
    # Check for missing fields
    for feature in required_features:
        if feature not in input_data:
            raise BadRequest(f"Missing required field: {feature}")
    
    # Check data types
    for feature, value in input_data.items():
        if not isinstance(value, (int, float)):
            raise BadRequest(f"Invalid data type for {feature}. Expected number, got {type(value)}")
    
    # Check value ranges
    value_ranges = {
        'Study Hours per Day': (0, 24),
        'Sleep Hours per Night': (0, 24),
        'Attendance Percentage': (0, 100),
        'Screen Time Hours': (0, 24),
        'Previous Exam Scores': (0, 100),
        'Study Consistency Score': (1, 10),
        'Extracurricular Activities': (1, 10),
        'Class Participation': (1, 10)
    }
    
    for feature, (min_val, max_val) in value_ranges.items():
        if feature in input_data:
            value = input_data[feature]
            if value < min_val or value > max_val:
                raise BadRequest(f"{feature} must be between {min_val} and {max_val}. Got {value}")
    
    return True
```

