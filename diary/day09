##  Hands-on Practice

### Recommendation System Architecture

I designed a comprehensive recommendation system with the following components:

#### 1. Student Profile Analysis
```python
class StudentProfile:
    def __init__(self, student_data, model, feature_names):
        self.student_data = student_data
        self.model = model
        self.feature_names = feature_names
        self.current_productivity = None
        self.recommendations = []
    
    def predict_productivity(self):
        """Predict current productivity level"""
        prediction = self.model.predict([self.student_data])[0]
        self.current_productivity = prediction
        return prediction
    
    def get_current_level(self):
        """Get current productivity level"""
        levels = {0: 'Low', 1: 'Med', 2: 'High'}
        return levels.get(self.current_productivity, 'Unknown')
```

#### 2. Feature Impact Analysis
```python
class FeatureImpactAnalyzer:
    def __init__(self, model, feature_names, shap_values=None):
        self.model = model
        self.feature_names = feature_names
        self.shap_values = shap_values
        self.feature_importance = self._get_feature_importance()
    
    def _get_feature_importance(self):
        """Get feature importance from model"""
        if hasattr(self.model, 'feature_importances_'):
            return dict(zip(self.feature_names, self.model.feature_importances_))
        return {}
    
    def get_top_impact_features(self, student_data, n=5):
        """Get top features that can improve productivity"""
        # Get current prediction
        current_pred = self.model.predict_proba([student_data])[0]
        
        # Calculate potential improvements
        improvements = []
        for i, feature in enumerate(self.feature_names):
            importance = self.feature_importance.get(feature, 0)
            current_value = student_data[i]
            
            # Calculate potential impact (simplified)
            # For positive features: higher values improve productivity
            # For negative features: lower values improve productivity
            if feature in ['Study Hours per Day', 'Sleep Hours per Night', 'Attendance Percentage']:
                potential_improvement = importance * (1 - current_value)  # Normalized
            else:
                potential_improvement = importance * current_value  # Normalized
            
            improvements.append((feature, potential_improvement, importance))
        
        # Sort by potential improvement
        improvements.sort(key=lambda x: x[1], reverse=True)
        return improvements[:n]
```

#### 3. Personalized Recommendation Generator
```python
class RecommendationGenerator:
    def __init__(self, impact_analyzer):
        self.impact_analyzer = impact_analyzer
        self.recommendation_templates = self._load_recommendation_templates()
    
    def _load_recommendation_templates(self):
        """Load recommendation templates for different features"""
        templates = {
            'Study Hours per Day': {
                'Low': "Increase your daily study time to at least 2-3 hours. Create a study schedule and stick to it consistently.",
                'Med': "Aim for 4-5 hours of focused study daily. Use techniques like Pomodoro to maintain concentration.",
                'High': "Maintain your excellent study habits. Consider adding variety to your study methods to prevent burnout."
            },
            'Sleep Hours per Night': {
                'Low': "Prioritize getting 7-8 hours of sleep nightly. Create a bedtime routine and avoid screens before bed.",
                'Med': "Try to maintain consistent sleep patterns. Aim for 7-8 hours and avoid late-night study sessions.",
                'High': "Your sleep habits are excellent. Keep maintaining this consistency for optimal productivity."
            },
            'Attendance Percentage': {
                'Low': "Make it a priority to attend all classes. Regular attendance helps you stay on track and understand concepts better.",
                'Med': "Good attendance! Aim for perfect attendance to maximize your learning opportunities.",
                'High': "Excellent attendance record! Keep it up and continue engaging actively in class."
            },
            'Screen Time Hours': {
                'Low': "Your screen time is well-managed. Continue using digital devices responsibly.",
                'Med': "Try to reduce non-essential screen time. Set limits on social media and entertainment apps.",
                'High': "Reduce your screen time significantly. Excessive screen time can negatively impact your focus and sleep."
            }
        }
        return templates
    
    def generate_recommendations(self, student_data, current_level, target_level='High'):
        """Generate personalized recommendations"""
        recommendations = []
        
        # Get top features for improvement
        top_features = self.impact_analyzer.get_top_impact_features(student_data, n=3)
        
        for feature, improvement, importance in top_features:
            # Determine current level for this feature
            feature_level = self._determine_feature_level(student_data, feature)
            
            # Get recommendation template
            template = self.recommendation_templates.get(feature, {}).get(feature_level, "")
            
            if template:
                recommendations.append({
                    'feature': feature,
                    'importance': importance,
                    'current_level': feature_level,
                    'recommendation': template,
                    'potential_impact': improvement
                })
        
        return recommendations
    
    def _determine_feature_level(self, student_data, feature):
        """Determine the level (Low/Med/High) for a specific feature"""
        feature_index = self.impact_analyzer.feature_names.index(feature)
        value = student_data[feature_index]
        
        # Define thresholds for each feature
        thresholds = {
            'Study Hours per Day': {'Low': 2, 'Med': 4, 'High': 6},
            'Sleep Hours per Night': {'Low': 6, 'Med': 7, 'High': 8},
            'Attendance Percentage': {'Low': 70, 'Med': 85, 'High': 95},
            'Screen Time Hours': {'Low': 2, 'Med': 4, 'High': 6}
        }
        
        if feature in thresholds:
            if value < thresholds[feature]['Low']:
                return 'Low'
            elif value < thresholds[feature]['Med']:
                return 'Med'
            else:
                return 'High'
        return 'Med'
```

#### 4. Recommendation Delivery System

I implemented a user-friendly interface for delivering recommendations:

```python
class RecommendationDeliverySystem:
    def __init__(self, model, feature_names, shap_values=None):
        self.profile = StudentProfile(None, model, feature_names)
        self.impact_analyzer = FeatureImpactAnalyzer(model, feature_names, shap_values)
        self.recommendation_generator = RecommendationGenerator(self.impact_analyzer)
    
    def get_personalized_recommendations(self, student_data):
        """Get complete personalized recommendations for a student"""
        # Predict current productivity
        current_level = self.profile.predict_productivity()
        current_level_name = self.profile.get_current_level()
        
        # Generate recommendations
        recommendations = self.recommendation_generator.generate_recommendations(
            student_data, current_level_name
        )
        
        # Create comprehensive report
        report = {
            'current_productivity': current_level_name,
            'recommendations': recommendations,
            'next_steps': self._generate_next_steps(current_level_name)
        }
        
        return report
    
    def _generate_next_steps(self, current_level):
        """Generate next steps based on current productivity level"""
        next_steps = {
            'Low': [
                "Focus on improving your study habits and consistency",
                "Prioritize sleep and health for better concentration",
                "Increase class attendance and participation"
            ],
            'Med': [
                "Aim for more consistent study patterns",
                "Optimize your sleep schedule for better performance",
                "Increase engagement in class and extracurricular activities"
            ],
            'High': [
                "Maintain your excellent habits",
                "Consider mentoring other students",
                "Explore advanced learning opportunities"
            ]
        }
        return next_steps.get(current_level, [])
    
    def display_recommendation_report(self, student_data, student_name="Student"):
        """Display a formatted recommendation report"""
        report = self.get_personalized_recommendations(student_data)
        
        print("=" * 60)
        print(f"PERSONALIZED PRODUCTIVITY RECOMMENDATION REPORT")
        print(f"Student: {student_name}")
        print("=" * 60)
        print(f"\nCurrent Productivity Level: {report['current_productivity']}")
        print("\n" + "-" * 60)
        print("TOP RECOMMENDATIONS FOR IMPROVEMENT")
        print("-" * 60)
        
        for i, rec in enumerate(report['recommendations'], 1):
            print(f"\n{i}. {rec['feature']} (Importance: {rec['importance']:.2f})")
            print(f"   Current Level: {rec['current_level']}")
            print(f"   Recommendation: {rec['recommendation']}")
            print(f"   Potential Impact: {rec['potential_impact']:.2f}")
        
        print("\n" + "-" * 60)
        print("NEXT STEPS")
        print("-" * 60)
        for i, step in enumerate(report['next_steps'], 1):
            print(f"{i}. {step}")
        
        print("\n" + "=" * 60)
```

