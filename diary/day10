#### 2. Create Prediction Function
```python
import numpy as np
import pandas as pd
import joblib
import json

def load_model_artifacts():
    """Load all model artifacts"""
    model = joblib.load('student_productivity_model.pkl')
    
    with open('model_metadata.json', 'r') as f:
        metadata = json.load(f)
    
    scaler = joblib.load('scaler.pkl')
    label_encoder = joblib.load('label_encoder.pkl')
    
    return model, metadata, scaler, label_encoder

def preprocess_input(input_data, feature_names, scaler, label_encoder):
    """Preprocess user input for prediction"""
    # Create DataFrame from input
    input_df = pd.DataFrame([input_data], columns=feature_names)
    
    # Apply preprocessing (scaling, encoding, etc.)
    # Note: This should match the preprocessing done during training
    
    # Scale numerical features
    numerical_features = ['Study Hours per Day', 'Sleep Hours per Night', 
                         'Attendance Percentage', 'Screen Time Hours']
    input_df[numerical_features] = scaler.transform(input_df[numerical_features])
    
    # Encode categorical features (if any)
    categorical_features = ['Extracurricular Activities', 'Class Participation']
    for feature in categorical_features:
        if feature in input_df.columns:
            input_df[feature] = label_encoder.transform(input_df[feature])
    
    return input_df

def predict_productivity(input_data):
    """Predict productivity level for given input"""
    # Load model artifacts
    model, metadata, scaler, label_encoder = load_model_artifacts()
    
    # Preprocess input
    feature_names = metadata['feature_names']
    processed_input = preprocess_input(input_data, feature_names, scaler, label_encoder)
    
    # Make prediction
    prediction = model.predict(processed_input)[0]
    prediction_proba = model.predict_proba(processed_input)[0]
    
    # Get class label
    class_labels = metadata['class_labels']
    predicted_class = class_labels[prediction]
    
    # Create result
    result = {
        'predicted_class': predicted_class,
        'confidence': float(prediction_proba[prediction]),
        'probabilities': {class_labels[i]: float(prob) for i, prob in enumerate(prediction_proba)},
        'feature_names': feature_names
    }
    
    return result
```

### Web Interface Development

I developed a web application using Flask for the backend and HTML/CSS for the frontend:

#### 1. Backend (Flask Application)
```python
from flask import Flask, request, jsonify, render_template
import numpy as np
import json

app = Flask(__name__)

# Load model artifacts at startup
model, metadata, scaler, label_encoder = load_model_artifacts()

@app.route('/')
def index():
    """Render the main page"""
    return render_template('index.html')

@app.route('/predict', methods=['POST'])
def predict():
    """Handle prediction requests"""
    try:
        # Get input data from request
        input_data = request.json
        
        # Validate input
        if not input_data:
            return jsonify({'error': 'No input data provided'}), 400
        
        # Convert to numpy array in the correct order
        feature_names = metadata['feature_names']
        input_array = np.array([input_data[feature] for feature in feature_names])
        
        # Preprocess and predict
        processed_input = preprocess_input(input_array.reshape(1, -1), 
                                          feature_names, scaler, label_encoder)
        prediction = model.predict(processed_input)[0]
        prediction_proba = model.predict_proba(processed_input)[0]
        
        # Get class label
        class_labels = metadata['class_labels']
        predicted_class = class_labels[prediction]
        
        # Create response
        result = {
            'predicted_class': predicted_class,
            'confidence': float(prediction_proba[prediction]),
            'probabilities': {class_labels[i]: float(prob) for i, prob in enumerate(prediction_proba)},
            'recommendations': generate_recommendations(input_array, predicted_class)
        }
        
        return jsonify(result)
    
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/recommendations', methods=['POST'])
def get_recommendations():
    """Handle recommendation requests"""
    try:
        input_data = request.json
        predicted_class = input_data.get('predicted_class', 'Med')
        
        # Generate recommendations
        recommendations = generate_recommendations(input_data, predicted_class)
        
        return jsonify({'recommendations': recommendations})
    
    except Exception as e:
        return jsonify({'error': str(e)}), 500

